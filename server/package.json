{
  "name": "dayflow-server",
  "version": "1.0.0",
  "description": "Dayflow HRMS Attendance Module Backend API",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/db/seed.js",
    "db:import": "node src/db/importSql.js",
    "db:check": "node src/db/checkDb.js",
    "test": "cross-env NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0"
  }
}
