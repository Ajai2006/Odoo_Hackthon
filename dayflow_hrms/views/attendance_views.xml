<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_tree_inherit_dayflow" model="ir.ui.view">
        <field name="name">hr.attendance.tree.dayflow</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.view_attendance_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='check_out']" position="after">
                <field name="punctuality_status" widget="badge" decoration-success="punctuality_status == 'on_time'" decoration-warning="punctuality_status == 'late'" decoration-danger="punctuality_status == 'incomplete'"/>
                <field name="late_minutes"/>
            </xpath>
        </field>
    </record>
</odoo>
